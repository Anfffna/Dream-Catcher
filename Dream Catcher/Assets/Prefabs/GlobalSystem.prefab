  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuestUIManager
  quests:
  - questId: turn_on_light
    tag: 0
    title: "\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0441\u0432\u0435\u0442"
    description: "\u0421\u043D\u043E\u0432\u0430 \u044F \u043F\u0440\u043E\u0441\u043F\u0430\u043B
      \u0446\u0435\u043B\u044B\u0439 \u0434\u0435\u043D\u044C."
    outlines:
    - {fileID: 0}
  - questId: find_the_key
    tag: 0
    title: "\u041D\u0430\u0439\u0442\u0438 \u043A\u043B\u044E\u0447\u0438"
    description: "\u041D\u0435 \u043F\u043E\u043C\u043D\u044E, \u043A\u043E\u0433\u0434\u0430
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0440\u0430\u0437 \u0432\u044B\u0445\u043E\u0434\u0438\u043B
      \u0438\u0437 \u0434\u043E\u043C\u0430.."
    outlines: []
  - questId: check_the_mailbox
    tag: 0
    title: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043F\u043E\u0447\u0442\u043E\u0432\u044B\u0439
      \u044F\u0449\u0438\u043A"
    description: "\u042D\u0442\u043E \u0443\u0436\u0435 \u0432\u043E\u0448\u043B\u043E
      \u0432 \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0443. \u041D\u0430\u0432\u0435\u0440\u043D\u043E
      \u0432\u0441\u0435 \u0435\u0449\u0435 \u0436\u0434\u0443 \u043D\u043E\u0432\u043E\u0441\u0442\u0435\u0439."
    outlines:
    - {fileID: 0}
  - questId: go_to_depart
    tag: 0
    title: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F \u0432
      \u0434\u0435\u043F\u0430\u0440\u0442\u0430\u043C\u0435\u043D\u0442"
    description: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C \u0447\u0442\u043E
      \u0438\u0437 \u0441\u0435\u0431\u044F \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u044D\u0442\u0430 \u0440\u0430\u0431\u043E\u0442\u0430.."
    outlines: []
  - questId: find_about_job
    tag: 0
    title: "\u0423\u0437\u043D\u0430\u0442\u044C \u043F\u0440\u043E \u0442\u0440\u0443\u0434\u043E\u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E"
    description: "\u0418 \u043A\u0443\u0434\u0430 \u0436\u0435 \u043C\u043D\u0435
      \u043F\u043E\u0434\u0430\u0442\u044C\u0441\u044F?"
    outlines: []
