    useAudio: 0
    voiceAudioSource: {fileID: 0}
    clickPauseDelay: 0
  - text: "\u0422\u043E\u043B\u044C\u043A\u043E \u043D\u043E\u0432\u043E\u0441\u0442\u0438
      \u0443\u0432\u0438\u0434\u0435\u043B."
