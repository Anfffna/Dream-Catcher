  dialogueManager: {fileID: 0}
  dialogueLines:
  - text: "\u041F\u0440\u0438\u0432\u0435\u0442 \u0441\u043E\u0441\u0435\u0434, \u0442\u044B
      \u0441\u043B\u044B\u0445\u0430\u043B \u043F\u0440\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0443?"
