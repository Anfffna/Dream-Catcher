    useAudio: 0
    voiceAudioSource: {fileID: 0}
    clickPauseDelay: 0
  - text: "\u041C\u043D\u0435 \u044D\u0442\u0443 \u0448\u0442\u0443\u043A\u0443 \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0438, \u043D\u0443 \u0434\u043B\u044F
      \u0437\u0430\u043F\u0438\u0441\u0438 \u0441\u043D\u0430."
    useCustomColor: 0
    colorHex: 
    useAudio: 0
    voiceAudioSource: {fileID: 0}
    clickPauseDelay: 0
  - text: "\u0411\u043E\u044E\u0441\u044C \u044F \u0438\u043C \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F,
