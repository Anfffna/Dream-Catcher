  dialoguePanel: {fileID: 1010188688}
  dialogueText: {fileID: 807466792}
  dialogueLines:
  - text: "\u201C\u0421 \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0435\u0433\u043E
      \u0434\u043D\u044F \u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0430\u0446\u0438\u044F
      \u0441\u043D\u043E\u0432\u0438\u0434\u0435\u043D\u0438\u0439 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439 \u0434\u043B\u044F
      \u0432\u0441\u0435\u0445 \u0433\u0440\u0430\u0436\u0434\u0430\u043D.\u201D"
  - text: "\u201C\u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u0434\u0430\u043D\u043D\u044B\u043C
      \u0414\u0435\u043F\u0430\u0440\u0442\u0430\u043C\u0435\u043D\u0442\u0430 \u0441\u043D\u0430,
      \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0441\u043B\u0443\u0447\u0430\u0435\u0432
      \u0434\u0435\u0441\u0442\u0440\u0443\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E
      \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u044F \u0441\u043D\u0438\u0437\u0438\u043B\u043E\u0441\u044C
      \u043D\u0430 80%. \u0414\u0430 \u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0435\u0442
      \u041C\u0438\u043D\u0438\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E!\u201D"
  - text: "\u201C\u0412\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0442\u0430
      \u0441\u0442\u0430\u043D\u0446\u0438\u044F \u041C\u0435\u0442\u0440\u043E \u041F\u0440\u043E\u0446\u0432\u0435\u0442\u0430\u043D\u0438\u044F\u2026\u201D"
  standDialogueLines:
  - text: "\u041E\u043F\u044F\u0442\u044C \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F
      \u043F\u043E\u0434 \u044D\u0442\u0438 \u0434\u043E\u043B\u0431\u0430\u043D\u043D\u044B\u0435
      \u043D\u043E\u0432\u043E\u0441\u0442\u0438."
  standDialogueColorHex: '#A997C9'
  questUIManager: {fileID: 600496376}
  taskPanelController: {fileID: 1613126431}
  lettersPerSecond: 25
  hidePanelOnStart: 1
  hidePanelOnEnd: 1
