--- !u!114 &1648375913
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1648375910}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a1328a0b5c74f1849a8efd6709784d5e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::InviteDoor
  audioSource: {fileID: 1648375912}
  knockClip: {fileID: 8300000, guid: 8db02fc29f9582440bb70e4db4c60bcf, type: 3}
  loopKnock: 1
  delayAfterLight: 3
  delayAfterKnock: 1.5
  questUIManager: {fileID: 600496376}
  questIdToAdd: find_the_key
  dialogueManager: {fileID: 1942194844}
  ggLines:
  - text: "\u041A\u043E\u0433\u043E \u044D\u0442\u043E \u043A\u043E \u043C\u043D\u0435
      \u0437\u0430\u043D\u0435\u0441\u043B\u043E?"
    useCustomColor: 1
    colorHex: '#A997C9'
    clickPauseDelay: 0
  workerLines:
  - text: "\u0414\u043E\u0431\u0440\u044B\u0439 \u0434\u0435\u043D\u044C. \u0422\u043E\u0432\u0430\u0440\u0438\u0449
      \u0412\u043E\u0440\u043E\u043D\u0446\u043E\u0432?"
    useCustomColor: 0
    colorHex: 
    clickPauseDelay: 0
  - text: "\u0414\u0430."
    useCustomColor: 1
    colorHex: '#A997C9'
    clickPauseDelay: 0
  - text: "\u0412\u0430\u043C \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D\u043E
      \u0442\u0440\u0443\u0434\u043E\u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
      \u0432 \u0434\u0435\u043F\u0430\u0440\u0442\u0430\u043C\u0435\u043D\u0442,
      \u0432\u044B\u0439\u0442\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
      \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E."
    useCustomColor: 0
    colorHex: 
    clickPauseDelay: 0
  - text: "\u0421 \u0447\u0435\u0433\u043E \u0432\u0434\u0440\u0443\u0433?"
    useCustomColor: 1
    colorHex: '#A997C9'
    clickPauseDelay: 0
  - text: "\u0412\u0430\u0448 \u043E\u043F\u044B\u0442 \u043F\u0440\u0438\u0437\u043D\u0430\u043D
      \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u043C."
    useCustomColor: 0
    colorHex: 
    clickPauseDelay: 0
  - text: "\u042F \u0443\u0436\u0435 \u0433\u043E\u0434 \u043D\u0438\u0433\u0434\u0435
      \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u044E."
    useCustomColor: 1
    colorHex: '#A997C9'
    clickPauseDelay: 0
  - text: "\u0418\u043C\u0435\u043D\u043D\u043E \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u0432\u0430\u043C \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u044E\u0442
      \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0441\u0442\u044C."
    useCustomColor: 0
    colorHex: 
    clickPauseDelay: 2
  - text: "\u041B\u044E\u0434\u044F\u043C \u0432 \u0432\u0430\u0448\u0435\u043C \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0438
      \u0442\u044F\u0436\u0435\u043B\u043E \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F
      \u043E\u0434\u043D\u0438\u043C."
    useCustomColor: 0
    colorHex: 
    clickPauseDelay: 2
  doorInteractable: {fileID: 8451438757294240980}
  npcToHide: {fileID: 925543333}
