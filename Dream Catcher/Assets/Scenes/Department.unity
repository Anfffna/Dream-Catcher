MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 762447359}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d2f986eb6111ce847afd770487df2443, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FindAboutJob
  questIdToComplete: find_about_job
  questIdToAddAfterSecondDialogue: find_workplace
  activationDelay: 2
  firstDialogueLines:
  - text: "\u0417\u0434\u0440\u0430\u0441\u044C\u0442\u0435, \u043C\u0435\u043D\u044F
      \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u043B\u0438 \u0441\u044E\u0434\u0430
      \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0443"
    useCustomColor: 1
    colorHex: '#A997C9'
    useAudio: 0
    voiceAudioSource: {fileID: 0}
    clickPauseDelay: 0
  - text: "\u0417\u0430\u0431\u043E\u0440 \u043F\u043E\u043A\u0440\u0430\u0441\u044C\u0442\u0435.
      \u041F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u0442\u0435 \u0434\u0438\u043F\u043B\u043E\u043C
      \u043E \u0432\u044B\u0441\u0448\u0435\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u0438,
      \u0441\u043F\u0440\u0430\u0432\u043A\u0443 \u043E \u0441\u0443\u0434\u0438\u043C\u043E\u0441\u0442\u0438,
      \u0440\u0435\u0437\u044E\u043C\u0435 \u0438 \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0438\u0435
      \u0434\u0430\u043D\u043D\u044B\u0435."
    useCustomColor: 0
    colorHex: 
    useAudio: 1
    voiceAudioSource: {fileID: 762447365}
    clickPauseDelay: 0
  - text: "\u041C\u0435\u043D\u044F \u043E \u0442\u0430\u043A\u043E\u043C \u043D\u0435
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u043B\u0438..."
    useCustomColor: 1
    colorHex: '#A997C9'
    useAudio: 0
    voiceAudioSource: {fileID: 0}
    clickPauseDelay: 0
  - text: "\u0424\u0430\u043C\u0438\u043B\u0438\u044F?"
    useCustomColor: 0
    colorHex: 
    useAudio: 1
    voiceAudioSource: {fileID: 762447365}
    clickPauseDelay: 0
  - text: "\u0412\u043E\u0440\u043E\u043D\u0446\u043E\u0432"
    useCustomColor: 1
    colorHex: '#A997C9'
    useAudio: 0
    voiceAudioSource: {fileID: 0}
    clickPauseDelay: 1
  - text: "\u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u043A\u043B\u044E\u0447
      \u0438 \u043F\u0440\u043E\u043F\u0443\u0441\u043A. \u041F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u0435
      \u043A \u043E\u043A\u043D\u0443 112."
    useCustomColor: 0
    colorHex: 
    useAudio: 1
    voiceAudioSource: {fileID: 762447365}
    clickPauseDelay: 0
  secondDialogueLines:
  - text: "\u0427\u0435\u0433\u043E \u0432\u0441\u0442\u0430\u043B \u043D\u0430\u0434
      \u0434\u0443\u0448\u043E\u0439?"
    useCustomColor: 0
    colorHex: 
    useAudio: 1
    voiceAudioSource: {fileID: 762447365}
    clickPauseDelay: 0
