--- !u!114 &1018455439
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1018455438}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aa337c6ffbe3a174faabd32eac39dd27, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::WalkBoss
  questUIManager: {fileID: 0}
  questId: walk_to_boss
  addNextQuestOnComplete: 1
  nextQuestId: get_to_work
  bossDialogueTrigger: {fileID: 770381630}
  makeBossDialogueColliderTriggerOnStart: 1
  exitCompleteTrigger: {fileID: 1895342193}
  makeExitCompleteColliderTriggerOnStart: 1
  dialogueManager: {fileID: 0}
  dialogueLines:
  - text: "\u041C\u043B\u0430\u0434\u0448\u0438\u0439 \u0430\u043D\u0430\u043B\u0438\u0442\u0438\u043A
      \u0412\u043E\u0440\u043E\u043D\u0446\u043E\u0432."
    useCustomColor: 1
    colorHex: '#A997C9'
    useAudio: 0
    voiceAudioSource: {fileID: 0}
    clickPauseDelay: 0
  - text: "\u041E\u043F\u043E\u0437\u0434\u0430\u043B\u0438 \u043D\u0430 \u0442\u0440\u0438
      \u043C\u0438\u043D\u0443\u0442\u044B."
    useCustomColor: 0
    colorHex: 
    useAudio: 1
    voiceAudioSource: {fileID: 1018455441}
    clickPauseDelay: 0
  - text: "\u042F \u0434\u0430\u0436\u0435 \u043D\u0435 \u0437\u043D\u0430\u043B
      \u043A\u0443\u0434\u0430 \u0438\u0434\u0442\u0438."
    useCustomColor: 1
    colorHex: '#A997C9'
    useAudio: 0
    voiceAudioSource: {fileID: 0}
    clickPauseDelay: 0
  - text: "\u0422\u0435\u043F\u0435\u0440\u044C \u0437\u043D\u0430\u0435\u0442\u0435.
      \u0421\u043B\u0443\u0448\u0430\u0439\u0442\u0435 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
      \u0432\u0442\u043E\u0440\u043E\u0439 \u0440\u0430\u0437 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u0442\u044C
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0431\u0443\u0434\u0435\u0442."
    useCustomColor: 0
    colorHex: 
    useAudio: 1
    voiceAudioSource: {fileID: 1018455441}
    clickPauseDelay: 0
  - text: "\u0412\u0430\u0448\u0430 \u0440\u0430\u0431\u043E\u0442\u0430 - \u0430\u043D\u0430\u043B\u0438\u0437
      \u0441\u043D\u043E\u0432\u0438\u0434\u0435\u043D\u0438\u0439 \u0438 \u0432\u044B\u044F\u0432\u043B\u0435\u043D\u0438\u0435
      \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u043E\u0432 \u0434\u0435\u0441\u0442\u0440\u0443\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E
      \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u044F."
    useCustomColor: 0
    colorHex: 
    useAudio: 1
    voiceAudioSource: {fileID: 1018455441}
    clickPauseDelay: 0
  - text: "\u0410 \u0447\u0442\u043E \u0442\u0430\u043A\u043E\u0435 \u0434\u0435\u0441\u0442\u0440\u0443\u043A\u0442\u0438\u0432\u043D\u043E\u0435
      \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u0435?"
    useCustomColor: 1
    colorHex: '#A997C9'
    useAudio: 0
    voiceAudioSource: {fileID: 0}
    clickPauseDelay: 0
  - text: "\u0415\u0441\u043B\u0438 \u0431\u044B \u0432\u0430\u043C \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043E
      \u0431\u044B\u043B\u043E \u0437\u043D\u0430\u0442\u044C, \u0432\u044B \u0431\u044B
      \u0441\u0438\u0434\u0435\u043B\u0438 \u043D\u0435 \u0437\u0430 112 \u0441\u0442\u043E\u0439\u043A\u043E\u0439. "
    useCustomColor: 0
    colorHex: 
    useAudio: 1
    voiceAudioSource: {fileID: 1018455441}
    clickPauseDelay: 0
  - text: "\u0417\u0430 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0443\u044E
      \u0440\u0430\u0431\u043E\u0442\u0443 \u043D\u0430\u0447\u0438\u0441\u043B\u044F\u0435\u0442\u0441\u044F
      \u0441\u0442\u0430\u0436. \u041F\u0440\u0438 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E\u043C
      \u0443\u0440\u043E\u0432\u043D\u0435 \u0434\u043E\u043F\u0443\u0441\u043A\u0430
      \u0432\u043E\u0437\u043C\u043E\u0436\u0435\u043D \u043F\u0435\u0440\u0435\u0432\u043E\u0434
      \u0432 \u0441\u0442\u0430\u0440\u0448\u0438\u0439 \u0441\u0435\u043A\u0442\u043E\u0440."
    useCustomColor: 0
    colorHex: 
    useAudio: 1
    voiceAudioSource: {fileID: 1018455441}
    clickPauseDelay: 0
  - text: "\u041F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435?"
    useCustomColor: 1
    colorHex: '#A997C9'
    useAudio: 0
    voiceAudioSource: {fileID: 0}
    clickPauseDelay: 0
  - text: "\u041D\u0435 \u043D\u0430\u0437\u044B\u0432\u0430\u0439\u0442\u0435 \u044D\u0442\u043E
      \u0442\u0430\u043A. \u041F\u0440\u043E\u0441\u0442\u043E\u2026 \u0434\u0440\u0443\u0433\u043E\u0439
      \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438."
    useCustomColor: 0
    colorHex: 
    useAudio: 1
    voiceAudioSource: {fileID: 1018455441}
    clickPauseDelay: 0
  - text: "\u0410 \u043F\u043E\u0447\u0435\u043C\u0443 \u0438\u043C\u0435\u043D\u043D\u043E
      \u044F?"
    useCustomColor: 1
    colorHex: '#A997C9'
    useAudio: 0
    voiceAudioSource: {fileID: 0}
    clickPauseDelay: 0
  - text: "\u0412\u0430\u0448\u0435 \u043F\u0440\u043E\u0448\u043B\u043E\u0435 \u043C\u0435\u0441\u0442\u043E
      \u0440\u0430\u0431\u043E\u0442\u044B \u043F\u0440\u0438\u0437\u043D\u0430\u043D\u043E
      \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u043C \u0441 \u0442\u0435\u043A\u0443\u0449\u0438\u043C\u0438
      \u0437\u0430\u0434\u0430\u0447\u0430\u043C\u0438 \u0434\u0435\u043F\u0430\u0440\u0442\u0430\u043C\u0435\u043D\u0442\u0430.
      \u042D\u0442\u043E\u0433\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E."
    useCustomColor: 0
    colorHex: 
    useAudio: 1
    voiceAudioSource: {fileID: 1018455441}
    clickPauseDelay: 0
  - text: "\u042F \u043F\u043E\u0447\u0442\u0438 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u043F\u043E\u043C\u043D\u044E \u043E \u0442\u043E\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0438."
    useCustomColor: 1
    colorHex: '#A997C9'
    useAudio: 0
    voiceAudioSource: {fileID: 0}
    clickPauseDelay: 0
  - text: "\u0414\u043B\u044F \u0432\u0430\u0448\u0435\u0439 \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u0438
      \u043F\u0430\u043C\u044F\u0442\u044C \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F."
    useCustomColor: 0
    colorHex: 
    useAudio: 1
    voiceAudioSource: {fileID: 1018455441}
    clickPauseDelay: 0
  blockMovementDuringDialogue: 1
  bossDoor: {fileID: 453450786}
  playerTag: Player
  autoFindReferences: 1
  questUIManagerObjectName: QuestUIManager
  dialogueManagerObjectName: DialogueManager
