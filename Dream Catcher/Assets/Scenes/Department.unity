--- !u!114 &1867201104
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1867201101}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cafe37710e4991a42b2e4cc0b59a1018, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TalkWorker
  dialogueManager: {fileID: 0}
  dialogueLines:
  - text: "\u042D\u0442\u043E \u0432\u0435\u0434\u044C \u0432\u044B \u043C\u0435\u043D\u044F
      \u0441\u044E\u0434\u0430 \u043F\u0440\u0438\u0437\u0432\u0430\u043B\u0438?\u041C\u043E\u0436\u0435\u0442
      \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u0435 \u043F\u043E\u0447\u0435\u043C\u0443
      \u0438 \u0447\u0442\u043E \u043E\u0442 \u043C\u0435\u043D\u044F \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F?"
    useCustomColor: 1
    colorHex: '#A997C9'
    clickPauseDelay: 0
  - text: "\u0421 \u0442\u043E\u0431\u043E\u0439 \u043D\u044F\u043D\u0447\u0438\u0442\u044C\u0441\u044F
      \u0442\u0443\u0442 \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0431\u0443\u0434\u0435\u0442."
    useCustomColor: 0
    colorHex: 
    clickPauseDelay: 0
  - text: "\u0418\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438 \u0435\u0441\u0442\u044C,
      \u0434\u0438\u0440\u0435\u043A\u0442\u0438\u0432\u044B \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u044E\u0442\u0441\u044F."
    useCustomColor: 0
    colorHex: 
    clickPauseDelay: 0
  - text: "\u0415\u0441\u043B\u0438 \u043E\u0431\u043B\u0430\u0436\u0430\u0435\u0448\u044C\u0441\u044F
      - \u0443\u0437\u043D\u0430\u0435\u0448\u044C \u043E\u0431 \u044D\u0442\u043E\u043C
      \u043F\u0435\u0440\u0432\u044B\u0439."
    useCustomColor: 0
    colorHex: 
    clickPauseDelay: 0
  - text: "\u0427\u0442\u043E \u044D\u0442\u043E \u0437\u0430 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u044F
      \u0445\u043E\u0442\u044C?"
    useCustomColor: 1
    colorHex: '#A997C9'
    clickPauseDelay: 0
  - text: "\u041C\u043B\u0430\u0434\u0448\u0438\u0439 \u0430\u043D\u0430\u043B\u0438\u0442\u0438\u043A
      \u0414\u0421"
    useCustomColor: 0
    colorHex: 
    clickPauseDelay: 0
  - text: "\u0414\u0421?"
    useCustomColor: 1
    colorHex: '#A997C9'
    clickPauseDelay: 0
  - text: "\u0414\u0435\u043F\u0430\u0440\u0442\u0430\u043C\u0435\u043D\u0442 \u0441\u043D\u043E\u0432,
      \u0442\u044B \u0447\u0435 \u0441 \u043B\u0443\u043D\u044B \u0441\u0432\u0430\u043B\u0438\u043B\u0441\u044F?"
    useCustomColor: 0
    colorHex: 
    clickPauseDelay: 0
  - text: "\u041D\u0435 \u0437\u0430\u0434\u0430\u0432\u0430\u0439 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432, \u0437\u0430 \u043D\u0435\u0437\u043D\u0430\u043D\u0438\u0435
      \u043C\u043E\u0436\u043D\u043E \u0434\u043E\u043D\u043E\u0441 \u0441\u0445\u043B\u043E\u043F\u043E\u0442\u0430\u0442\u044C."
    useCustomColor: 0
    colorHex: 
    clickPauseDelay: 0
  - text: "\u0410, \u0438 \u043E\u0442\u0447\u0438\u0442\u0430\u0439\u0441\u044F
      \u043D\u0430\u0447\u0430\u043B\u044C\u0441\u0442\u0432\u0443."
    useCustomColor: 0
    colorHex: 
    clickPauseDelay: 0
  blockMovementDuringDialogue: 1
