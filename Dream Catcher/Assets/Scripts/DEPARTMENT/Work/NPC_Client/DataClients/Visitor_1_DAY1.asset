  visitorId: visitor_001
  clientName: "\u0418\u0412\u0410\u041D\u041E\u0412 \u041C.\u041C."
  occupation: "\u041C\u041B\u0410\u0414\u0428\u0418\u0419 \u0410\u041D\u0410\u041B\u0418\u0422\u0418\u041A"
  voiceClip: {fileID: 8300000, guid: e3caaf6191afecc4cb7b464fe4abaecd, type: 3}
  caseVariants:
  - variantId: A
    registrationNumber: 3457-2356
    recordDate: 07/08/2007
    firstDialogue:
    - text: "\u0414\u043E\u0431\u0440\u044B\u0439 \u0432\u0435\u0447\u0435\u0440."
      useCustomColor: 0
      colorHex: 
      useAudio: 1
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    - text: "\u0412\u043E\u0442, \u0434\u0435\u0440\u0436\u0438\u0442\u0435."
      useCustomColor: 0
      colorHex: 
      useAudio: 1
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 5
    - text: "\u0427\u0442\u043E-\u0442\u043E \u043D\u0435 \u0442\u0430\u043A?.."
      useCustomColor: 0
      colorHex: 
      useAudio: 1
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    - text: "\u041D\u0435\u0442. \u041F\u0435\u0440\u0432\u044B\u0439 \u0434\u0435\u043D\u044C
        \u043F\u0440\u043E\u0441\u0442\u043E.."
      useCustomColor: 1
      colorHex: '#A997C9'
      useAudio: 0
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    - text: "\u0410-\u0430.. \u041C\u0435\u043D\u044F \u0432\u0447\u0435\u0440\u0430
        \u043C\u0438\u043D\u0443\u0442 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
        \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u043B\u0438."
      useCustomColor: 0
      colorHex: 
      useAudio: 1
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    - text: "\u0423 \u043D\u0438\u0445 \u043A\u0430\u043A\u0430\u044F-\u0442\u043E
        \u0432\u043E\u0437\u043D\u044F \u0441 \u043B\u043E\u0442\u043A\u043E\u043C
        \u0431\u044B\u043B\u0430."
      useCustomColor: 0
      colorHex: 
      useAudio: 1
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    giveSon3DuringFirstDialogue: 1
    giveSon3DialogueIndex: 1
    questionMenuOpeningLine:
      text: "\u041E\u0442 \u043C\u0435\u043D\u044F \u0435\u0449\u0435 \u0447\u0442\u043E-\u0442\u043E
        \u043D\u0443\u0436\u043D\u043E?"
      useCustomColor: 0
      colorHex: 
      useAudio: 1
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    complaintsQuestion:
      questionId: complaintsA
      questionText: "\u0416\u0430\u043B\u043E\u0431\u044B?"
      responseDialogue:
      - text: "\u0416\u0430\u043B\u043E\u0431\u044B \u043D\u0430 \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
          \u0438\u043C\u0435\u044E\u0442\u0441\u044F?"
        useCustomColor: 1
        colorHex: '#A997C9'
        useAudio: 0
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u0414\u0430 \u043D\u0435 \u043B\u044E\u0431\u043B\u044E \u044F \u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C\u0441\u044F..
          \u041D\u043E \u0442\u044B \u0432\u0440\u043E\u0434\u0435 \u043C\u0443\u0436\u0438\u043A
          \u0445\u043E\u0440\u043E\u0448\u0438\u0439, \u0442\u0435\u0431\u0435 \u0441\u043A\u0430\u0436\u0443."
        useCustomColor: 0
        colorHex: 
        useAudio: 1
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u0422\u0440\u0435\u0432\u043E\u0433\u0430 \u043C\u0435\u043D\u044F
          \u0437\u0430\u0435\u043B\u0430.. \u0421\u0430\u043C \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C,
          \u0432 \u043A\u0430\u043A\u043E\u043C \u043C\u0438\u0440\u0435 \u0436\u0438\u0432\u0435\u043C."
        useCustomColor: 0
        colorHex: 
        useAudio: 1
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
    personalQuestion:
      questionId: questionA
      questionText: "\u0415\u0449\u0435 \u0432\u043E\u043F\u0440\u043E\u0441..."
      responseDialogue:
      - text: "\u0421\u043E\u043D \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
          \u0443\u044E\u0442\u043D\u043E. \u041B\u044E\u0431\u0438\u0442\u0435 \u0447\u0430\u0435\u043F\u0438\u0442\u0438\u044F?"
        useCustomColor: 1
        colorHex: '#A997C9'
        useAudio: 0
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u0423\u0436\u0435 \u043D\u0435 \u043E\u0447\u0435\u043D\u044C."
        useCustomColor: 0
        colorHex: 
        useAudio: 1
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u041F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0430
          \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C."
        useCustomColor: 0
        colorHex: 
        useAudio: 1
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u0418\u043D\u043E\u0433\u0434\u0430 \u0441\u0442\u0430\u0432\u043B\u044E
          \u0434\u0432\u0435 \u043A\u0440\u0443\u0436\u043A\u0438 \u0438 \u0442\u043E\u043B\u044C\u043A\u043E
          \u043F\u043E\u0442\u043E\u043C \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u044E."
        useCustomColor: 0
        colorHex: 
        useAudio: 1
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u0413\u043B\u0443\u043F\u043E \u0437\u0432\u0443\u0447\u0438\u0442,
          \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435."
        useCustomColor: 0
        colorHex: 
        useAudio: 1
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
    giveSon3Dialogue:
    - text: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F \u043D\u0430 \u044D\u0442\u043E\u043C
        \u0432\u0441\u0435.. \u041D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
        \u0434\u043E\u043B\u0436\u043D\u043E \u043F\u0440\u0438\u0439\u0442\u0438
        \u0432\u0430\u043C \u043D\u0430 \u043F\u043E\u0447\u0442\u0443"
      useCustomColor: 1
      colorHex: '#A997C9'
      useAudio: 0
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    - text: "\u0418 \u043D\u0430 \u0442\u043E\u043C \u0441\u043F\u0430\u0441\u0438\u0431\u043E.
        \u0410 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E-\u0442\u043E
        \u0432\u0435\u0440\u043D\u0435\u0442\u0435?"
      useCustomColor: 0
      colorHex: 
      useAudio: 1
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    finalDialogue:
    - text: "\u041D\u0443 \u0434\u043E \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u044F,
        \u0442\u043E\u0432\u0430\u0440\u0438\u0449. \u041C\u043E\u0436\u0435\u0442
        \u0435\u0449\u0435 \u0437\u0434\u0435\u0441\u044C \u0441\u0432\u0438\u0434\u0438\u043C\u0441\u044F."
      useCustomColor: 0
      colorHex: 
      useAudio: 1
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    dreamVideoClip: {fileID: 0}
    correctDirection:
      correctDecision: 2
      correctSymptoms:
      - "\u0422\u0420\u0415\u0412\u041E\u0416\u041D\u041E\u0421\u0422\u042C"
      correctGrounds:
      - "\u041D\u0415\u0419\u0422\u0420\u0410\u041B\u042C\u041D\u042B\u0419 \u0421\u041E\u041D"
