      clickPauseDelay: 0
    complaintsQuestion:
      questionId: complaintsB
      questionText: "\u0416\u0430\u043B\u043E\u0431\u044B?"
      responseDialogue:
      - text: "\u041D\u0430 \u0447\u0442\u043E \u0436\u0430\u043B\u0443\u0435\u0442\u0435\u0441\u044C?"
        useCustomColor: 1
        colorHex: '#A997C9'
        useAudio: 0
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u041D\u0443 \u043D\u0430\u0441\u043C\u043E\u0440\u043A \u0443 \u043C\u0435\u043D\u044F..
          \u0410 \u0442\u0430\u043A \u0432 \u0431\u043E\u0434\u0440\u043E\u043C \u0437\u0434\u0440\u0430\u0432\u0438\u0438
          \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F."
        useCustomColor: 0
        colorHex: 
        useAudio: 0
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
    personalQuestion:
      questionId: questionB
      questionText: "\u0415\u0449\u0435 \u0432\u043E\u043F\u0440\u043E\u0441..."
      responseDialogue:
      - text: "\u041F\u043E\u043C\u043D\u0438\u0442\u0435, \u043A\u0443\u0434\u0430
          \u0431\u0435\u0436\u0430\u043B\u0438?"
        useCustomColor: 1
        colorHex: '#A997C9'
        useAudio: 0
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u041F\u043E\u043D\u044F\u0442\u0438\u044F \u043D\u0435 \u0438\u043C\u0435\u044E."
        useCustomColor: 0
        colorHex: 
        useAudio: 0
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u0413\u043B\u0430\u0432\u043D\u043E\u0435, \u0447\u0442\u043E \u043D\u0435
          \u043E\u0442 \u043A\u043E\u0433\u043E-\u0442\u043E."
        useCustomColor: 1
        colorHex: '#A997C9'
        useAudio: 0
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 1.5
      - text: "\u0417\u0430\u0432\u0442\u0440\u0430 \u0441\u0432\u0430\u0434\u044C\u0431\u0430."
        useCustomColor: 0
        colorHex: 
        useAudio: 0
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u041F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u044F\u044E \u0432\u0430\u0441."
        useCustomColor: 1
        colorHex: '#A997C9'
        useAudio: 0
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u041F\u043E\u043A\u0430 \u0440\u0430\u043D\u043E. \u0421\u0442\u0440\u0430\u0448\u043D\u043E
          \u0434\u043E \u0443\u0441\u0440\u0430\u0447\u043A\u0438.."
        useCustomColor: 0
        colorHex: 
        useAudio: 0
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
    giveSon3Dialogue:
    - text: "\u0413\u043E\u0442\u043E\u0432\u043E, \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
        \u0434\u043E\u043B\u0436\u043D\u043E \u043F\u0440\u0438\u0439\u0442\u0438
        \u0432\u0430\u043C \u043D\u0430 \u043F\u043E\u0447\u0442\u0443."
      useCustomColor: 1
      colorHex: '#A997C9'
      useAudio: 0
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    finalDialogue:
    - text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E
        \u0432\u0435\u0447\u0435\u0440\u0430."
      useCustomColor: 0
      colorHex: 
      useAudio: 0
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    - text: "\u0410 \u0432\u0430\u043C \u0445\u043E\u0440\u043E\u0448\u0435\u0439
        \u0441\u0432\u0430\u0434\u044C\u0431\u044B."
      useCustomColor: 0
