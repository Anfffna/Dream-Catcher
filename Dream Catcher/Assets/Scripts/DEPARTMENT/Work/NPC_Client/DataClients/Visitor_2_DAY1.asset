  visitorId: visitor_002
  clientName: "\u041A\u0410\u0417\u0410\u041D\u041E\u0412 \u0424.\u041D."
  occupation: "\u041C\u041B\u0410\u0414\u0428\u0418\u0419 \u0410\u041D\u0410\u041B\u0418\u0422\u0418\u041A"
  voiceClip: {fileID: 0}
  caseVariants:
  - variantId: A
    registrationNumber: 5698-1267
    recordDate: 07/08/2007
    firstDialogue:
    - text: "\u0412\u0435\u0447\u0435\u0440 \u0434\u043E\u0431\u0440\u044B\u0439."
      useCustomColor: 0
      colorHex: 
      useAudio: 0
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    - text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435."
      useCustomColor: 1
      colorHex: '#A997C9'
      useAudio: 0
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    - text: "\u0412\u043E\u0442, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430.
        \u041D\u043E\u0447\u044C \u0432\u0440\u043E\u0434\u0435 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0430\u044F
        \u0431\u044B\u043B\u0430, \u0442\u0430\u043A \u0447\u0442\u043E, \u0434\u0443\u043C\u0430\u044E,
        \u0442\u0430\u043C \u043D\u0438\u0447\u0435\u0433\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E\u0433\u043E."
      useCustomColor: 0
      colorHex: 
      useAudio: 0
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    - text: "\u0425\u043E\u0442\u044F \u0432\u0430\u043C, \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435,
        \u0432\u0438\u0434\u043D\u0435\u0435."
      useCustomColor: 0
      colorHex: 
      useAudio: 0
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    giveSon3DuringFirstDialogue: 1
    giveSon3DialogueIndex: 2
    questionMenuOpeningLine:
      text: "\u041C?"
      useCustomColor: 0
      colorHex: 
      useAudio: 0
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    complaintsQuestion:
      questionId: complaintsA
      questionText: "\u0416\u0430\u043B\u043E\u0431\u044B?"
      responseDialogue:
      - text: "\u0412\u0430\u0441 \u0447\u0442\u043E-\u0442\u043E \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0438\u0442?"
        useCustomColor: 1
        colorHex: '#A997C9'
        useAudio: 0
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u0414\u0430 \u043D\u0435\u0442, \u0432 \u043E\u0431\u0449\u0435\u043C-\u0442\u043E.."
        useCustomColor: 0
        colorHex: 
        useAudio: 0
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u0414\u0430\u0436\u0435 \u043D\u0430\u043E\u0431\u043E\u0440\u043E\u0442.
          \u0414\u0430\u0432\u043D\u043E \u043C\u043D\u0435 \u043D\u0438\u0447\u0435\u0433\u043E
          \u0442\u0430\u043A\u043E\u0433\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0433\u043E
          \u043D\u0435 \u0441\u043D\u0438\u043B\u043E\u0441\u044C."
        useCustomColor: 0
        colorHex: 
        useAudio: 0
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
    personalQuestion:
      questionId: questionA
      questionText: "\u0415\u0449\u0435 \u0432\u043E\u043F\u0440\u043E\u0441..."
      responseDialogue:
      - text: "\u0417\u0430 \u043A\u0430\u043A\u0443\u044E \u043A\u043E\u043C\u0430\u043D\u0434\u0443
          \u0431\u043E\u043B\u0435\u0435\u0442\u0435?"
        useCustomColor: 1
        colorHex: '#A997C9'
        useAudio: 0
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u0414\u0430 \u0443\u0436\u0435 \u043D\u0435 \u0437\u0430 \u043A\u0430\u043A\u0443\u044E.."
        useCustomColor: 0
        colorHex: 
        useAudio: 0
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u0420\u0430\u043D\u044C\u0448\u0435 \u0441 \u0441\u044B\u043D\u043E\u043C
          \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E \u043D\u0430 \u043C\u0430\u0442\u0447\u0438
          \u0445\u043E\u0434\u0438\u043B\u0438. \u041E\u043D \u0435\u0449\u0451 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
          \u0431\u044B\u043B - \u043E\u0440\u0430\u043B \u0433\u0440\u043E\u043C\u0447\u0435
          \u0432\u0441\u0435\u0439 \u0442\u0440\u0438\u0431\u0443\u043D\u044B."
        useCustomColor: 0
        colorHex: 
        useAudio: 0
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u041F\u043E\u0442\u043E\u043C \u0432\u044B\u0440\u043E\u0441. \u0421\u0442\u0430\u043B\u0438
          \u0441\u043E\u0437\u0432\u0430\u043D\u0438\u0432\u0430\u0442\u044C\u0441\u044F
          \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u0430\u043C."
        useCustomColor: 0
        colorHex: 
        useAudio: 0
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u041D\u0430\u0432\u0435\u0440\u043D\u043E \u043F\u043E\u044D\u0442\u043E\u043C\u0443
          \u0438 \u043F\u0440\u0438\u0441\u043D\u0438\u043B\u043E\u0441\u044C."
        useCustomColor: 1
        colorHex: '#A997C9'
        useAudio: 0
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
    giveSon3Dialogue:
    - text: "\u0414\u0443\u043C\u0430\u044E \u0432\u0441\u0435. \u041E\u0442\u043A\u043B\u044E\u0447\u0443
        \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E \u0438 \u043C\u043E\u0436\u0435\u0442\u0435
        \u0431\u044B\u0442\u044C \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B."
      useCustomColor: 1
      colorHex: '#A997C9'
      useAudio: 0
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    finalDialogue:
    - text: "\u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B\u0438.
        \u0414\u043E \u0441\u0432\u0438\u0434\u0430\u043D\u0438\u044F!"
      useCustomColor: 0
      colorHex: 
      useAudio: 0
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    dreamVideoClip: {fileID: 0}
    correctDirection:
      correctDecision: 1
