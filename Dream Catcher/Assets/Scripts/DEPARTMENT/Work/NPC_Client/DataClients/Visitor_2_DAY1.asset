      correctGrounds:
      - "\u041F\u041E\u0417\u0418\u0422\u0418\u0412\u041D\u042B\u0419 \u0421\u041E\u041D"
  - variantId: B
    registrationNumber: 1185-0430
    recordDate: 07/08/2007
    firstDialogue:
    - text: "\u0412\u0435\u0447\u0435\u0440 \u0434\u043E\u0431\u0440\u044B\u0439."
      useCustomColor: 0
      colorHex: 
      useAudio: 0
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    - text: "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435."
      useCustomColor: 1
      colorHex: '#A997C9'
      useAudio: 0
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    - text: "\u0412\u043E\u0442. \u0421\u0435\u0433\u043E\u0434\u043D\u044F, \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
        \u0431\u0435\u0437 \u043A\u043E\u0448\u043C\u0430\u0440\u043E\u0432."
      useCustomColor: 0
      colorHex: 
      useAudio: 0
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    giveSon3DuringFirstDialogue: 1
    giveSon3DialogueIndex: 1
    questionMenuOpeningLine:
      text: "\u0427\u0442\u043E-\u0442\u043E \u0435\u0449\u0435?"
      useCustomColor: 0
      colorHex: 
      useAudio: 0
