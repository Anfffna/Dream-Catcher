  m_Script: {fileID: 11500000, guid: 1e65fb666f074b24fb0d9f1ba31d77db, type: 3}
  m_Name: Visitor_3_DAY1
  m_EditorClassIdentifier: Assembly-CSharp::VisitorCaseData
  visitorId: visitor_003
  clientName: "\u041A\u0420\u042B\u041B\u041E\u0412 \u041C.\u0412."
  occupation: "\u041C\u041B\u0410\u0414\u0428\u0418\u0419 \u0410\u041D\u0410\u041B\u0418\u0422\u0418\u041A"
  voiceClip: {fileID: 8300000, guid: e3caaf6191afecc4cb7b464fe4abaecd, type: 3}
  caseVariants:
  - variantId: A
    registrationNumber: 6773-0481
    recordDate: 07/08/2007
    firstDialogue:
    - text: "\u0414\u043E\u0431\u0440\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438
        \u0441\u0443\u0442\u043E\u043A."
      useCustomColor: 0
      colorHex: 
      useAudio: 1
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    - text: "\u0418 \u0432\u0430\u043C \u043D\u0435 \u0445\u0432\u043E\u0440\u0430\u0442\u044C."
      useCustomColor: 1
      colorHex: '#A997C9'
      useAudio: 0
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    - text: "\u0412\u043E\u0442, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430."
      useCustomColor: 0
      colorHex: 
      useAudio: 1
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    giveSon3DuringFirstDialogue: 1
    giveSon3DialogueIndex: 1
    questionMenuOpeningLine:
      text: "\u042F \u0447\u0442\u043E-\u0442\u043E \u0435\u0449\u0435 \u0432\u0430\u043C
        \u0434\u043E\u043B\u0436\u0435\u043D? "
      useCustomColor: 0
      colorHex: 
      useAudio: 1
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    complaintsQuestion:
      questionId: complaintsA
      questionText: "\u0416\u0430\u043B\u043E\u0431\u044B?"
      responseDialogue:
      - text: "\u041D\u0430 \u0447\u0442\u043E-\u0442\u043E \u0436\u0430\u043B\u0443\u0435\u0442\u0435\u0441\u044C?"
        useCustomColor: 1
        colorHex: '#A997C9'
        useAudio: 0
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u041D\u0435\u0442, \u0432\u0441\u0435 \u0447\u0443\u0434\u0435\u0441\u043D\u043E!"
        useCustomColor: 0
        colorHex: 
        useAudio: 1
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u041C\u043E\u044F \u0434\u043E\u0447\u044C \u0437\u0430\u0432\u0442\u0440\u0430
          \u0434\u043E\u043C\u043E\u0439 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F.."
        useCustomColor: 0
        colorHex: 
        useAudio: 1
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
    personalQuestion:
      questionId: questionA
      questionText: "\u0415\u0449\u0435 \u0432\u043E\u043F\u0440\u043E\u0441..."
      responseDialogue:
      - text: "\u041E\u0442\u043A\u0443\u0434\u0430 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F?"
        useCustomColor: 1
        colorHex: '#A997C9'
        useAudio: 0
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u0418\u0437 \u0430\u0440\u043C\u0438\u0438."
        useCustomColor: 0
        colorHex: 
        useAudio: 1
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0440\u0430\u0437 \u0437\u0430
          \u0442\u0440\u0438 \u0433\u043E\u0434\u0430 \u0443\u0432\u0438\u0434\u0438\u043C\u0441\u044F."
        useCustomColor: 0
        colorHex: 
        useAudio: 1
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u0422\u0440\u0438 \u0433\u043E\u0434\u0430.. \u0420\u0430\u043D\u044C\u0448\u0435
          \u043D\u0435 \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u043B\u0438? "
        useCustomColor: 1
        colorHex: '#A997C9'
        useAudio: 0
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u0422\u043E \u0443\u0447\u0435\u043D\u0438\u044F, \u0442\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438..
          \u041D\u0443 \u0432\u0441\u0435 \u043D\u0430 \u0431\u043B\u0430\u0433\u043E
          \u0433\u043E\u0441\u0443\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0442\u0430\u043A
          \u0441\u043A\u0430\u0437\u0430\u0442\u044C."
        useCustomColor: 0
        colorHex: 
        useAudio: 1
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u041D\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0430\u0434\u0435\u044E\u0441\u044C
          \u0442\u043E\u0447\u043D\u043E \u043F\u0440\u0438\u0435\u0434\u0435\u0442..
          \u0423\u0436\u0435 \u0441\u0442\u043E\u043B \u043D\u0430\u043A\u0440\u044B\u043B."
        useCustomColor: 0
        colorHex: 
        useAudio: 1
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
      - text: "\u0414\u0430\u0436\u0435 \u0432\u044B\u0445\u043E\u0434\u043D\u043E\u0439
          \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0435 \u0432\u0437\u044F\u043B,
          \u0447\u0442\u043E\u0431\u044B \u043D\u0438\u043A\u0443\u0434\u0430 \u043D\u0435
          \u0434\u0451\u0440\u0433\u0430\u0442\u044C\u0441\u044F."
        useCustomColor: 0
        colorHex: 
        useAudio: 1
        voiceAudioSource: {fileID: 0}
        clickPauseDelay: 0
    giveSon3Dialogue:
    - text: "\u0412\u0441\u0435 \u0433\u043E\u0442\u043E\u0432\u043E, \u0441\u0435\u0439\u0447\u0430\u0441
        \u0432\u0435\u0440\u043D\u0443 \u0432\u0430\u043C \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E."
      useCustomColor: 1
      colorHex: '#A997C9'
      useAudio: 0
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    finalDialogue:
    - text: "\u041B\u0430\u0434\u043D\u043E, \u0441\u043F\u0430\u0441\u0438\u0431\u043E
        \u0432\u0430\u043C \u0431\u043E\u043B\u044C\u0448\u043E\u0435, \u043F\u043E\u0435\u0434\u0443
        \u043A \u0434\u043E\u0447\u0435."
      useCustomColor: 0
      colorHex: 
      useAudio: 1
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    - text: "\u041D\u0430\u0434\u0435\u044E\u0441\u044C \u0432\u0441\u0435 \u0445\u043E\u0440\u043E\u0448\u043E
        \u0442\u0430\u043C, \u043D\u0443 \u043D\u0430 \u044D\u0442\u043E\u0439 \u0448\u0442\u0443\u043A\u043E\u0432\u0438\u043D\u0435."
      useCustomColor: 0
      colorHex: 
      useAudio: 1
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    - text: "\u0423\u0441\u043F\u0435\u0445\u043E\u0432 \u0432\u0430\u043C."
      useCustomColor: 1
      colorHex: '#A997C9'
      useAudio: 0
      voiceAudioSource: {fileID: 0}
      clickPauseDelay: 0
    dreamVideoClip: {fileID: 0}
    correctDirection:
      correctDecision: 3
      correctSymptoms: []
      correctGrounds:
      - "\u041A\u0420\u041E\u0412\u042C"
